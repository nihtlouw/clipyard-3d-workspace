# Floor feed — the diorama polls this URL for FloorSnapshot JSON.
#
# Phase 2 default (Floor API + vite /api proxy, gitignored in .env.local):
#   VITE_FLOOR_URL=/api/floor
#
# Other options:
#   VITE_FLOOR_URL=/api/floor.example.json   (static smoke payload)
#   VITE_FLOOR_URL=https://your-api/api/floor
#
# The Floor API push token is server-side only:
#   CLIPYARD_FLOOR_TOKEN=change-me   (server/floor-api.mjs)
